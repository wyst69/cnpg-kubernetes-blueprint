# {{ ansible_managed }}
# kube-prometheus-stack on {{ cluster.context }}, in agent mode.
#
# The operator plus a PrometheusAgent: it honours the PodMonitors CNPG creates
# in this cluster, keeps nothing locally, and remote-writes everything to the
# hub. Grafana and Alertmanager live on the hub, so they are off here.

crds:
  enabled: false          # applied separately, server-side, in crds.yml

grafana:
  enabled: false

alertmanager:
  enabled: false

kubeStateMetrics:
  enabled: true

nodeExporter:
  enabled: true

prometheusOperator:
  resources:
    requests:
      memory: 64Mi
      cpu: 25m

kube-state-metrics:
  resources:
    requests:
      memory: 64Mi
      cpu: 10m

prometheus-node-exporter:
  resources:
    requests:
      memory: 32Mi
      cpu: 10m

prometheus:
  agentMode: true

  service:
    type: ClusterIP

  prometheusSpec:
    podMonitorSelectorNilUsesHelmValues: false
    serviceMonitorSelectorNilUsesHelmValues: false

    externalLabels:
      # Named k8s_cluster, not cluster: CNPG's own exporter already emits a
      # `cluster` label (the Cluster CR name), and Prometheus's external_labels
      # are silently dropped whenever a scraped series already has a label of
      # that name (https://github.com/prometheus/prometheus/issues/12265) — so
      # `cluster: {{ cluster.name }}` here would never actually apply to any
      # cnpg_* metric, defeating the point of stamping which K8s cluster a
      # series came from once multiple clusters remote_write to the same hub.
      k8s_cluster: {{ cluster.name }}

      # ALSO stamp the plain `cluster` label, on purpose, despite the note
      # above: kube-prometheus-stack's own bundled dashboards (cluster-total,
      # k8s-resources-cluster, nodes, multicluster) all key their $cluster
      # template variable off this exact name via label_values(...). None of
      # them touch CNPG's exporter, and none of kubelet/cadvisor,
      # kube-state-metrics or node-exporter emit a `cluster` label of their
      # own — so the collision that forced k8s_cluster above doesn't apply
      # here. Without this, those stock dashboards silently blend hub/
      # cluster-a/cluster-b into one indistinguishable view (confirmed live,
      # not assumed).
      cluster: {{ cluster.name }}

    remoteWrite:
      - url: "http://{{ hub_service_ips.prometheus }}:9090/api/v1/write"

    resources:
      requests:
        memory: 256Mi
        cpu: 100m
