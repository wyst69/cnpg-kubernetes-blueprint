# {{ ansible_managed }}
# OpenTelemetry collector DaemonSet on {{ cluster.context }}, shipping to the
# hub's SigNoz at {{ hub_service_ips.signoz_otlp }}:4317.
#

mode: daemonset

presets:
  kubernetesAttributes:
    enabled: true
  kubeletMetrics:
    enabled: true
  hostMetrics:
    enabled: true
  logsCollection:
    enabled: true

image:
  repository: otel/opentelemetry-collector-contrib

config:
  exporters:
    otlp_grpc:
      endpoint: "{{ hub_service_ips.signoz_otlp }}:4317"
      tls:
        insecure: true

  processors:
    # k8s_attributes can only extract the cluster's UUID (k8s.cluster.uid),
    # not a readable name. This is a literal, Ansible-rendered value per
    # collector instance. Uses the OTel semantic-convention key
    # (k8s.cluster.name) — SigNoz's Logs Explorer "Cluster Name" quick
    # filter is keyed off this exact name, same as k8s.namespace.name /
    # k8s.deployment.name already showing up there.
    resource/cluster:
      attributes:
        - key: k8s.cluster.name
          value: "{{ cluster.name }}"
          action: upsert

  service:
    pipelines:
      traces:
        processors: [k8s_attributes, resource/cluster, memory_limiter, batch]
        exporters: [otlp_grpc]
      metrics:
        processors: [k8s_attributes, resource/cluster, memory_limiter, batch]
        exporters: [otlp_grpc]
      logs:
        processors: [k8s_attributes, resource/cluster, memory_limiter, batch]
        exporters: [otlp_grpc]

  receivers:
    prometheus:
      config:
        scrape_configs:
          - job_name: opentelemetry-collector
            scrape_interval: 30s
            static_configs:
              - targets: ["${env:MY_POD_IP}:8888"]
          # otel-signoz has no Prometheus Operator watching PodMonitor CRs
          # (that only happens under the kube-prometheus stack), so a CNPG
          # Cluster's own PodMonitor is inert here. This job replicates it
          # directly: any pod carrying cnpg.io/cluster with a container port
          # named "metrics", cluster-wide (RBAC for pod discovery is already
          # granted by the kubernetesAttributes/kubeletMetrics presets above).
          - job_name: cnpg-cluster-metrics
            scrape_interval: 30s
            kubernetes_sd_configs:
              - role: pod
            relabel_configs:
              - source_labels: [__meta_kubernetes_pod_label_cnpg_io_cluster]
                action: keep
                regex: .+
              - source_labels: [__meta_kubernetes_pod_container_port_name]
                action: keep
                regex: metrics
              - source_labels: [__meta_kubernetes_namespace]
                target_label: namespace
              - source_labels: [__meta_kubernetes_pod_name]
                target_label: pod
              - source_labels: [__meta_kubernetes_pod_label_cnpg_io_cluster]
                target_label: cnpg_cluster

resources:
  limits:
    memory: 512Mi
