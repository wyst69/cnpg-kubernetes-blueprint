# {{ ansible_managed }}
# {{ secrets_cfg.image_repo }} — standalone, file storage on a PVC.
#
# One template serves both providers: the openbao chart is a fork of vault-helm
# and kept the same value paths, so only the image and the storage path differ.
#
# Not dev mode: the data survives a pod restart, which means the PKI root CA,
# the Kubernetes auth paths and the policies survive too. The price is the
# init/unseal dance, which the playbook performs for you and records in
# {{ secrets_keys_file }}.

global:
  enabled: true
  tlsDisable: true

# The agent injector is not used by this lab — ESO and cert-manager talk to the
# server over the API. Leaving it off saves a Deployment and a webhook. (The
# openbao chart still ships an injector pointing at hashicorp/vault-k8s, which
# is another reason to keep it off.)
injector:
  enabled: false

csi:
  enabled: false

ui:
  enabled: true

server:
  image:
    repository: {{ secrets_cfg.image_repo }}
    tag: "{{ secrets_cfg.image_tag }}"

  dataStorage:
    enabled: true
    size: {{ secrets_data_size }}
    storageClass: {{ lab_storage_class }}
    accessMode: ReadWriteOnce

  auditStorage:
    enabled: false

  ha:
    enabled: false

  standalone:
    enabled: true
    config: |
      ui = true

      listener "tcp" {
        address     = "0.0.0.0:8200"
        tls_disable = 1
      }

      storage "file" {
        path = "{{ secrets_cfg.data_path }}"
      }

      # k3d nodes are containers; mlock is not available.
      disable_mlock = true

  # One Service, reachable two ways:
  #   - LoadBalancer IP  {{ hub_service_ips.secrets }}:8200  from the workload clusters
  #   - nodePort {{ hub_node_ports.secrets }} -> host port 8200      from your shell
  service:
    enabled: true
    type: LoadBalancer
    port: 8200
    targetPort: 8200
    # No nodePort here on purpose: the chart only renders it for type NodePort,
    # so it would be silently dropped. The deploy task patches it in afterwards.
    annotations:
      metallb.universe.tf/loadBalancerIPs: "{{ hub_service_ips.secrets }}"

  readinessProbe:
    enabled: true
    # Ready while still sealed, so the playbook can reach the pod to unseal it.
    path: "/v1/sys/health?standbyok=true&sealedcode=204&uninitcode=204"

  resources:
    requests:
      memory: 128Mi
      cpu: 100m
